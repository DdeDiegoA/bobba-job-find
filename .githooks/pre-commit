#!/usr/bin/env sh
# CH13 — optional fast pre-commit gate.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Disable:                 git config --unset core.hooksPath
# Skip a commit:           git commit --no-verify
#
# Keeps the two-minute problems out of CI: conventions, formatting and lint.
# The full gate (build, tests, cargo deny) stays in CI.
set -eu

cd "$(git rev-parse --show-toplevel)"

if command -v node >/dev/null 2>&1; then
  echo "pre-commit: conventions"
  node scripts/ci/check-conventions.mjs
fi

if command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: rustfmt"
  cargo fmt --all -- --check
fi

if command -v pnpm >/dev/null 2>&1 && [ -d node_modules ]; then
  echo "pre-commit: biome"
  pnpm lint
fi
