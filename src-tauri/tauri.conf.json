{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boba Job Find",
  "version": "0.1.0",
  "identifier": "app.bobajobfind",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boba Job Find",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/boba-mcp"],
    "category": "Productivity",
    "shortDescription": "Local-first, AI-assisted job search.",
    "longDescription": "Boba Job Find onboards your job boards and email, runs a daily search, ranks every offer, tailors your CV and applies for you."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/diegoarenas/boba-job-find/releases/latest/download/latest.json"
      ]
    }
  }
}
