{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boba Job Find",
  "version": "1.0.0-beta.4",
  "identifier": "app.bobajobfind",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boba Job Find",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/boba-mcp"],
    "category": "Productivity",
    "license": "MIT",
    "resources": { "../LICENSE": "LICENSE" },
    "copyright": "Copyright (c) 2026 Boba Job Find contributors. Portions copyright (c) 2026 Mads Lorentzen (ai-job-search, MIT).",
    "publisher": "Boba Job Find",
    "shortDescription": "Local-first, AI-assisted job search.",
    "longDescription": "Boba Job Find onboards your job boards and email, runs a daily search, ranks every offer, tailors your CV and applies for you.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3Qjc5RTdGQzQ3NTRFQzYKUldUR1RuWEVmNTYzeDcxQ3BoMlpXY3BSL2tMQi9sWlRuQjRPVkhGSFRCYmZqRmtkZlBpVkk1K3MK",
      "endpoints": [
        "https://github.com/DdeDiegoA/bobba-job-find/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
