# EditorConfig — cross-editor defaults (CH13).
# Biome (JS/TS/JSON/CSS) and rustfmt (Rust) own formatting; this file only
# keeps line endings, encoding and indentation aligned before those run.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc,css,html,yml,yaml}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{py}]
indent_size = 4

[*.{snippets}]
insert_final_newline = false

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
